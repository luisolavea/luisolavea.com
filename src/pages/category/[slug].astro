---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

// Descripciones por categoría
const categoryDescriptions: Record<string, string> = {
	vida: 'Reflexiones, experiencias y aprendizajes sobre la vida cotidiana, productividad y bienestar personal.',
	videos: 'Colección de videos recomendados sobre autismo, neurodivergencia y más.',
	domotica: 'Guías, tutoriales y experiencias con Home Assistant, dispositivos inteligentes y automatización del hogar.',
	'energia-solar': 'Todo sobre energía solar fotovoltaica: instalación, monitoreo, inversores y optimización del consumo.',
	tecnologia: 'Artículos sobre tecnología, desarrollo web, herramientas y tendencias del mundo digital.',
};

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const categories = [...new Set(posts.map((post) => post.data.category))];
	return categories.map((category) => ({
		params: { slug: category.toLowerCase().replace(/\s+/g, '-') },
		props: { category },
	}));
}

const { category } = Astro.props;
const posts = (await getCollection('blog'))
	.filter((post) => post.data.category === category)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const description = categoryDescriptions[category] || SITE_DESCRIPTION;
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`${category} | ${SITE_TITLE}`} description={description} />
		<style>
			main {
				width: 960px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 2em 1em;
			}
			.page-header {
				text-align: center;
				margin-bottom: 2rem;
				padding-bottom: 1.5rem;
				border-bottom: 2px solid rgb(var(--accent));
			}
			.page-header h1 {
				margin: 0;
				font-size: 2rem;
				color: rgb(var(--black));
				text-transform: capitalize;
			}
			.page-header p {
				margin: 0.75rem 0 0 0;
				color: rgb(var(--gray));
				font-size: 1.1rem;
				line-height: 1.5;
			}
			.post-count {
				display: inline-block;
				margin-top: 0.5rem;
				padding: 0.25rem 0.75rem;
				background: rgba(var(--accent), 0.1);
				color: rgb(var(--accent));
				border-radius: 999px;
				font-size: 0.875rem;
				font-weight: 500;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				.page-header h1 {
					font-size: 1.5rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<h1>{category}</h1>
				<p>{description}</p>
				<span class="post-count">{posts.length} {posts.length === 1 ? 'artículo' : 'artículos'}</span>
			</div>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/${post.id}/`}>
									{post.data.heroImage && (
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									)}
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
